# ─────────────────────────────────────────────────────────────
#  학꾸 (Hakku) — .env 템플릿
#  사용:  cp .env.template .env   후 아래 "<-- 채우기" 항목 입력.
#  주의:  .env 는 절대 커밋 금지(.gitignore 처리됨). 이 템플릿엔 시크릿을 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=hakku
POSTGRES_USER=hakku
POSTGRES_PASSWORD=                  # <-- 채우기 (로컬은 비워두면 'hakku' 기본값 / 배포는 강한 비밀번호)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Kafka ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── JWT ──────────────────────────────────────────────────────
# 생성: openssl rand -base64 32
JWT_SECRET=                         # <-- 채우기 (256-bit base64, 필수)
JWT_ACCESS_TTL_SECONDS=900          # 액세스 토큰 15분
JWT_REFRESH_TTL_SECONDS=1209600     # 리프레시 14일

# ── Payment (Toss) ───────────────────────────────────────────
# 생성: openssl rand -hex 32  (PG 콘솔에 등록한 웹훅 서명키와 동일해야 함)
PAYMENT_WEBHOOK_SECRET=             # <-- 채우기 (필수)
# 운영(실결제): 토스 대시보드의 '라이브' 시크릿키(live_…).
# 'test_' 샌드박스 키는 TossSecretKeyValidator 가 부팅을 거부함(unhealthy → nginx 미기동).
TOSS_SECRET_KEY=                    # <-- 채우기 (운영=live_… / 실결제 안 하면 아래 옵션 참고)
# (테스트 전용) 샌드박스(test_) 키로 띄우려면 아래 주석을 풀어 검증을 끈다. 기본/안전값은 ON(true).
#   docker-compose.yml 에 매핑돼 있어 .env 값이 그대로 적용됨. 실결제 운영에선 절대 끄지 말 것.
# PAYMENT_TOSS_SECRET_KEY_VALIDATION_ENABLED=false

# ── OpenAI (AI / Chatbot) ────────────────────────────────────
OPENAI_API_KEY=                     # <-- 채우기 (sk-… ; 로컬에서 AI 미사용이면 임의값으로 헬스만 통과)
OPENAI_IMAGE_MODEL=gpt-image-1
CHATBOT_MODEL=gpt-4o

# ── Storage ──────────────────────────────────────────────────
STORAGE_BASE_PATH=/data/images
