# ─────────────────────────────────────────────
#  학꾸 (Hakku) — Environment Template
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────
POSTGRES_DB=hakku
POSTGRES_USER=hakku
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── JWT ────────────────────────────────────────
# Generate a 256-bit base64 secret: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# ── Mattermost OAuth (Main Server) ─────────────
MATTERMOST_BASE_URL=https://mattermost.example.com
MATTERMOST_CLIENT_ID=replace-me
MATTERMOST_CLIENT_SECRET=replace-me
MATTERMOST_REDIRECT_URI=http://localhost/api/auth/oauth/callback

# ── OpenAI (AI Server) ─────────────────────────
OPENAI_API_KEY=sk-replace-me

# ── Storage Server ─────────────────────────────
STORAGE_BASE_PATH=/data/images
