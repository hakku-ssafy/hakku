# ─────────────────────────────────────────────
#  학꾸 (Hakku) — Environment Template
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────
POSTGRES_DB=hakku
POSTGRES_USER=hakku
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── JWT ────────────────────────────────────────
# Generate a 256-bit base64 secret: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# ── Payment Server ─────────────────────────────
# PG 웹훅 HMAC-SHA256 서명 검증용 공유 비밀키 (PG 콘솔에 등록한 값과 동일해야 함)
# Generate: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# ── OpenAI (AI Server) ─────────────────────────
# AI 진단 흐름:
#   유저 사진 + 퍼스널컬러 진단 템플릿 사진을 Image API에 함께 전달 → 결과 이미지 생성
#   → 원본 폐기, 결과 이미지 저장 → OCR로 결과 이미지에서 16종 퍼스널컬러 추출
OPENAI_API_KEY=sk-replace-me
OPENAI_IMAGE_MODEL=gpt-image-1
# 진단 템플릿 이미지 경로 (AI 서버에서 OpenAI 호출 시 함께 첨부)
PERSONAL_COLOR_TEMPLATE_PATH=/app/assets/personal-color-template.png

# ── Storage Server ─────────────────────────────
STORAGE_BASE_PATH=/data/images
