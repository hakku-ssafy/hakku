{
  "uid": "hakku-overview",
  "title": "학꾸 — Service Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["hakku"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (main-server)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "hakku-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"main-server\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP P95 Latency (main-server)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "hakku-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"main-server\"}[1m])) by (le, uri))",
          "legendFormat": "P95 {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Used (main-server)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "hakku-prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"main-server\", area=\"heap\"}",
          "legendFormat": "Heap Used"
        }
      ]
    },
    {
      "id": 4,
      "title": "Storage Uploads",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "hakku-prometheus" },
      "targets": [
        {
          "expr": "sum(storage_uploads_total) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "AI Server Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "hakku-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"ai-server\"}[1m])) by (handler, status_code)",
          "legendFormat": "{{handler}} {{status_code}}"
        }
      ]
    }
  ]
}
